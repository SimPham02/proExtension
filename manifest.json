{
  "name": "pro Extensions",
  "description": "Extension for everyone",
  "version": "1.4",
  "manifest_version": 3,
  "action": {
    "default_icon": "icon.png",
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/index.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https:; connect-src 'self' https:;"
  },
  "chrome_url_overrides": {
    "newtab": "src/features/edge-home/newtab.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content-scripts/translate.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "permissions": ["bookmarks", "storage", "tabs", "activeTab", "scripting", "cookies"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://api.mail.tm/*",
    "https://open.er-api.com/*",
    "http://*.studocu.com/*",
    "https://*.studocu.com/*"
  ]
}
