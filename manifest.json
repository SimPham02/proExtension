{
  "name": "Pro Extensions",
  "description": "Extension for everyone - Multi-utility extension for Chrome & Edge",
  "version": "1.4.1",
  "manifest_version": 3,
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    },
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/index.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https:; connect-src 'self' https:;"
  },
  "chrome_url_overrides": {
    "newtab": "src/features/edge-home/newtab.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content-scripts/translate.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "permissions": ["bookmarks", "storage", "unlimitedStorage", "tabs", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.mail.tm/*",
    "https://open.er-api.com/*",
    "https://translate.googleapis.com/*"
  ]
}
