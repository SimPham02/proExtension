{
  "name": "pro Extensions",
  "description": "Extension for everyone",
  "version": "1.4",
  "manifest_version": 3,
  "action": {
    "default_icon": "icon.png",
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/index.js"
  },
  "chrome_url_overrides": {
    "newtab": "src/features/edge-home/newtab.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content-scripts/translate.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "permissions": ["bookmarks", "storage", "tabs", "activeTab", "scripting", "cookies"],
  "host_permissions": ["<all_urls>"]
}